# my.telegram.org -> API development tools (аккаунт, от которого работает userbot)
API_ID=
API_HASH=
# @BotFather -> /mybots -> API Token
BOT_TOKEN=
# @userinfobot -> ваш числовой ID (админ бота)
OWNER_ID=
# Необязательно
TIMEZONE=Europe/Moscow
DATA_DIR=data
# Прокси, если Telegram недоступен напрямую (TimeoutError при подключении).
# SOCKS5/HTTP — используется и userbot, и ботом:
# PROXY_URL=socks5://user:pass@host:1080
# или MTProxy — только для userbot:
# MTPROXY=host:443:secret
